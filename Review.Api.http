### Register user
# @name registerUser
POST {{Review_Api_HostAddress}}/register
Content-Type: application/json

{
  "email": "{{Email}}",
  "password": "{{Password}}"
}

> {%
  client.test("registerUser status is 200 or 400", function () {
    client.assert(response.status === 200 || response.status === 400, "Expected 200 OK (new user) or 400 Bad Request (already exists)");
  });
%}

###

### Login (stores accessToken into global BearerToken for next requests)
# @name loginUser
POST {{Review_Api_HostAddress}}/login?useCookies=false
Content-Type: application/json

{
  "email": "{{Email}}",
  "password": "{{Password}}"
}

> {%
  client.test("loginUser status is 200", function () {
    client.assert(response.status === 200, "Expected 200 OK");
  });
  client.global.set("BearerToken", response.body.accessToken);
%}

###

### Create API key (requires bearer token)
# @name createApiKey
POST {{Review_Api_HostAddress}}/ApiKeys
Authorization: Bearer {{BearerToken}}
Content-Type: application/json

{
  "name": "My first API key"
}

> {%
  client.test("createApiKey status is 201", function () {
    client.assert(response.status === 201, "Expected 201 Created");
  });
  client.global.set("ApiKeyToken", response.body.token);
  client.global.set("ApiKeyId", response.body.token.split(".")[0]);
%}


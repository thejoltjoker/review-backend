### Create asset (auth with API key)
# @name createAsset
POST {{Review_Api_HostAddress}}/Assets
Authorization: ApiKey {{ApiKeyToken}}
Content-Type: application/json

{
  "fileName": "clip.mp4",
  "fileUrl": "https://example.com/files/clip.mp4",
  "fileType": "video/mp4",
  "projectId": "{{ProjectId}}"
}

> {%
  client.test("createAsset status is 201", function () {
    client.assert(response.status === 201, "Expected 201 Created");
  });
  client.global.set("AssetId", response.body.id);
%}


@Review.Api_HostAddress = http://localhost:5186
@Email = john.doe.http@example.com
@Password = password
@BearerToken = paste-bearer-token-here
@ApiKeyToken = paste-api-key-token-here
@ApiKeyId = paste-api-key-id-here
@ProjectId = paste-project-id-here
@AssetId = paste-asset-id-here
@CommentId = paste-comment-id-here

### Register user
POST {{Review.Api_HostAddress}}/register
Content-Type: application/json

{
  "email": "{{Email}}",
  "password": "{{Password}}"
}

###

### Login (copy accessToken from response into @BearerToken)
POST {{Review.Api_HostAddress}}/login?useCookies=false
Content-Type: application/json

{
  "email": "{{Email}}",
  "password": "{{Password}}"
}

###

### Create API key (requires bearer token)
POST {{Review.Api_HostAddress}}/ApiKeys
Authorization: Bearer {{BearerToken}}
Content-Type: application/json

{
  "name": "My first API key"
}

###

### List API keys (requires bearer token)
GET {{Review.Api_HostAddress}}/ApiKeys
Authorization: Bearer {{BearerToken}}
Accept: application/json

###

### Revoke API key (requires bearer token)
DELETE {{Review.Api_HostAddress}}/ApiKeys/{{ApiKeyId}}
Authorization: Bearer {{BearerToken}}

###

### Get all projects (auth with API key)
GET {{Review.Api_HostAddress}}/Projects
Authorization: ApiKey {{ApiKeyToken}}
Accept: application/json

###

### Get project by id (auth with API key)
GET {{Review.Api_HostAddress}}/Projects/{{ProjectId}}
Authorization: ApiKey {{ApiKeyToken}}
Accept: application/json

###

### Create project (auth with API key)
POST {{Review.Api_HostAddress}}/Projects
Authorization: ApiKey {{ApiKeyToken}}
Content-Type: application/json

{
  "name": "New demo project"
}

###

### Update project (auth with API key)
PUT {{Review.Api_HostAddress}}/Projects/{{ProjectId}}
Authorization: ApiKey {{ApiKeyToken}}
Content-Type: application/json

{
  "name": "Updated demo project"
}

###

### Delete project (auth with API key)
DELETE {{Review.Api_HostAddress}}/Projects/{{ProjectId}}
Authorization: ApiKey {{ApiKeyToken}}

###

### Get all assets (auth with API key)
GET {{Review.Api_HostAddress}}/Assets
Authorization: ApiKey {{ApiKeyToken}}
Accept: application/json

###

### Get asset by id (includes comments, auth with API key)
GET {{Review.Api_HostAddress}}/Assets/{{AssetId}}
Authorization: ApiKey {{ApiKeyToken}}
Accept: application/json

###

### Create asset (auth with API key)
POST {{Review.Api_HostAddress}}/Assets
Authorization: ApiKey {{ApiKeyToken}}
Content-Type: application/json

{
  "fileName": "clip.mp4",
  "fileUrl": "https://example.com/files/clip.mp4",
  "fileType": "video/mp4",
  "projectId": "{{ProjectId}}"
}

###

### Update asset (auth with API key)
PUT {{Review.Api_HostAddress}}/Assets/{{AssetId}}
Authorization: ApiKey {{ApiKeyToken}}
Content-Type: application/json

{
  "fileName": "clip-v2.mp4",
  "fileUrl": "https://example.com/files/clip-v2.mp4",
  "fileType": "video/mp4",
  "projectId": "{{ProjectId}}"
}

###

### Delete asset (auth with API key)
DELETE {{Review.Api_HostAddress}}/Assets/{{AssetId}}
Authorization: ApiKey {{ApiKeyToken}}

###

### Get comment by id (auth with API key)
GET {{Review.Api_HostAddress}}/Comments/{{CommentId}}
Authorization: ApiKey {{ApiKeyToken}}
Accept: application/json

###

### Create comment (auth with API key)
POST {{Review.Api_HostAddress}}/Comments
Authorization: ApiKey {{ApiKeyToken}}
Content-Type: application/json

{
  "content": "Start of intro section",
  "timestampSeconds": 12.5,
  "assetId": "{{AssetId}}",
  "userId": "ignored-by-server"
}

###

### Update comment (auth with API key)
PUT {{Review.Api_HostAddress}}/Comments/{{CommentId}}
Authorization: ApiKey {{ApiKeyToken}}
Content-Type: application/json

{
  "content": "Updated comment text",
  "timestampSeconds": 13.2
}

###

### Delete comment (auth with API key)
DELETE {{Review.Api_HostAddress}}/Comments/{{CommentId}}
Authorization: ApiKey {{ApiKeyToken}}
